#!/usr/bin/env python3
"""Print the newest visible Codex CLI model in a requested family."""

import json
import re
import subprocess
import sys


USAGE = "Usage: get_codex_latest [astra|sol|luna|terra]"
FAMILIES = {"astra", "sol", "luna", "terra"}


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] not in FAMILIES):
        print(USAGE, file=sys.stderr)
        return 2
    family = sys.argv[1] if len(sys.argv) == 2 else "astra"

    try:
        result = subprocess.run(
            ["codex", "debug", "models"], capture_output=True, text=True, check=False
        )
    except OSError as error:
        print(f"Cannot run codex debug models: {error}", file=sys.stderr)
        return 1
    if result.returncode:
        print(result.stderr.strip() or "codex debug models failed", file=sys.stderr)
        return result.returncode

    try:
        models = json.loads(result.stdout)["models"]
    except (ValueError, KeyError, TypeError) as error:
        print(f"Cannot parse Codex model catalog: {error}", file=sys.stderr)
        return 1

    candidates = []
    for model in models:
        if not isinstance(model, dict) or model.get("visibility") != "list":
            continue
        slug = model.get("slug", "")
        if not isinstance(slug, str):
            continue
        match = re.fullmatch(rf"gpt-(\d+(?:\.\d+)*)-{family}", slug)
        if match:
            candidates.append((tuple(map(int, match.group(1).split("."))), slug))
    if not candidates:
        print(f"No visible {family} model found in Codex model catalog", file=sys.stderr)
        return 1

    print(max(candidates)[1])
    return 0


if __name__ == "__main__":
    sys.exit(main())
