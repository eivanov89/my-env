export Y_FAST_CANCEL="yes"

if [[ -r "$HOME/ydb/path.bash.inc" && ":$PATH:" != *":$HOME/ydb/bin:"* ]]; then
    source "$HOME/ydb/path.bash.inc"
fi

if [[ -z "${BUILD_CORES:-}" ]]; then
    if [[ "$OSTYPE" == darwin* ]]; then
        __ydb_logical_cores="$(getconf NPROCESSORS_ONLN)"
        BUILD_CORES=$((__ydb_logical_cores > 2 ? __ydb_logical_cores - 2 : 1))
        if (( BUILD_CORES > 8 )); then
            BUILD_CORES=8
        fi
        unset __ydb_logical_cores
    else
        BUILD_CORES="$(nproc --ignore=4)"
        if (( BUILD_CORES > 100 )); then
            BUILD_CORES=100
        fi
    fi
fi
export BUILD_CORES

alias cds='cd ~/repos/ydb'
alias cdm='cd ~/repos/ydb_main'
alias cdw='cd ~/repos/ydb_worktrees'

function ymake_impl() {
    local profile="$1"
    shift

    ya make "-j${BUILD_CORES}" "--build=${profile}" "$@"
}

function ymr() {
    ymake_impl release -DCFLAGS=-fno-omit-frame-pointer "$@"
}

function ymp() {
    ymake_impl profile -DCFLAGS=-fno-omit-frame-pointer "$@"
}

function yma() {
    ymake_impl debug --sanitize=address "$@"
}

function ymt() {
    ymake_impl debug --sanitize=thread "$@"
}

function ymd() {
    ymake_impl debug "$@"
}

function yml() {
    ymake_impl debug --sanitize=leak "$@"
}
